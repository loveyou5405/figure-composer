{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Figure Composer",
  "version": "1.0.1",
  "identifier": "org.figurecomposer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Figure Composer v1.0.1",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Compose editable multi-page scientific figures",
    "longDescription": "A local-first A4 scientific figure composer with review and editable PowerPoint export."
  }
}
